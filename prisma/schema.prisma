generator client {
  provider        = "prisma-client"
  previewFeatures = ["strictUndefinedChecks"]
  output          = "../src/generated/prisma"
  runtime         = "bun"
}

datasource db {
  provider = "sqlite"
}

// --- Better Auth core schema ---------------------------------------------------------------------
// Generated shape from `auth generate`. Verification is required even though there is no email flow:
// it stores the OAuth `state` and PKCE `code_verifier` for every login.

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions Session[]
  accounts Account[]
  claims   CharacterClaim[]

  submissions Submission[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- guild-sim ------------------------------------------------------------------------------------

/// Mirror of the wowaudit roster, refreshed by the daily sync.
model RosterCharacter {
  /// wowaudit's own character id, used for wishlist uploads.
  id Int @id

  name  String
  realm String
  class String
  role  String
  rank  String

  /// Blizzard's `{realmId}-{characterId}`, the join key to a Battle.net account's characters.
  blizzardId String @unique

  /// A spec Raidbots refuses to sim (healers answer `unsupported_spec`). Cleared on a re-spec.
  unsupportedSpec String?

  syncedAt DateTime

  claims      CharacterClaim[]
  submissions Submission[]

  @@map("roster_character")
}

/// Proof that a Battle.net account owns a roster character, resolved from the WoW profile API at login.
/// This is the authorization record: a paste is only accepted for a character the signed-in user claims.
model CharacterClaim {
  userId      String
  characterId Int
  claimedAt   DateTime @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  character RosterCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([userId, characterId])
  @@index([characterId])
  @@map("character_claim")
}

/// One SimC paste. Kept so an admin can requeue the roster without asking anyone to re-paste.
model Submission {
  id          Int    @id @default(autoincrement())
  userId      String
  characterId Int

  simcText String
  spec     String

  /// From Raidbots' `profile.provenance.addonInfo`, used by the staleness gate.
  addonVersion String?
  wowVersion   String?
  exportedAt   DateTime?

  createdAt DateTime @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  character RosterCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  jobs      SimJob[]

  @@index([characterId, createdAt])
  @@map("submission")
}

/// One queued sim. A submission fans out to one job per configured difficulty.
model SimJob {
  id           Int    @id @default(autoincrement())
  submissionId Int

  sourceId   Int
  sourceName String
  difficulty String

  /// queued | running | uploading | done | failed | skipped
  status String @default("queued")

  simId String?
  error String?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, queuedAt])
  @@map("sim_job")
}

/// Raidbots droptimizer sources, refreshed daily so the admin UI always offers the current list.
model Source {
  raidbotsId   Int     @id
  name         String
  type         String
  seasonNumber Int?

  syncedAt DateTime

  @@map("source")
}

/// Everything the admin dashboard can change. Single row, lazily created with defaults.
model Settings {
  id Int @id @default(1)

  wowauditConfigurationName String  @default("Default")
  replaceManualEdits        Boolean @default(true)

  /// Comma-separated, matched against wowaudit ranks.
  ranks      String @default("GM,Officer,Raider")
  adminRanks String @default("GM,Officer")

  /// A Raidbots source name, or "season" for the current season's aggregate.
  source String @default("season")
  /// Comma-separated difficulty names.
  difficulties String @default("mythic")

  simcVersion String @default("weekly")
  iterations  String @default("smart")
  fightStyle  String @default("Patchwerk")
  fightLength Int    @default(300)
  enemyCount  Int    @default(1)

  concurrency     Int @default(1)
  submitsPerHour  Int @default(40)
  pollIntervalMs  Int @default(7000)

  /// exact | patch | off
  buildCheck      String @default("exact")
  maxPasteAgeDays Int    @default(3)

  /// Live WoW build from Raidbots' static metadata, refreshed by the sync.
  liveWowBuild String?
  /// Battle.net region, derived from the wowaudit team url by the sync.
  region String @default("us")
  /// Raidbots season number of wowaudit's current raids, so `source: "season"` resolves offline.
  currentSeasonNumber Int?

  updatedAt DateTime @default(now()) @updatedAt

  @@map("settings")
}

/// Replaces the CLI's `.guild-sim-state.json`. Single row.
model QuotaState {
  id Int @id @default(1)

  /// Submit timestamps inside the rolling hour, comma-separated epoch millis.
  submits String @default("")
  /// When Raidbots said the hourly limit resets. Authoritative where `submits` is a guess.
  quotaResetAt DateTime?

  @@map("quota_state")
}
