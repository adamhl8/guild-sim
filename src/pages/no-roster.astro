---
import Panel from "#components/Panel.astro"
import Base from "#layouts/Base.astro"
import { refreshAlert } from "#lib/alert.ts"

const { user, characters } = Astro.locals
if (!user) return Astro.redirect("/")
if (characters.length > 0) return Astro.redirect("/submit")

const alert = refreshAlert(Astro.url.searchParams.get("refresh"))
---

<Base title="Not on the roster" alert={alert}>
  <div class="mx-auto max-w-xl">
    <!-- A panel rather than a second alert: this is the page's content, and Base already owns the
      alert region directly above it. -->
    <Panel>
      <div class="p-6">
        <h1 class="text-lg font-semibold">You are not on the roster</h1>
        <p class="mt-2 text-sm text-base-content/70">
          You signed in as <strong class="text-base-content">{user.name}</strong>, but none of the
          characters on that Battle.net account are tracked in wowaudit.
        </p>
        <p class="mt-4 text-sm text-base-content/60">
          If you have just been added, ask an officer to re-sync the roster, then check again.
        </p>
        <form method="POST" action="/refresh-characters" class="mt-6">
          <button class="btn btn-primary btn-sm" type="submit">Refresh my characters</button>
        </form>
      </div>
    </Panel>
  </div>
</Base>
