---
import { Font } from "astro:assets"

import "#global.css"
import type { Alert } from "#lib/alert.ts"
import { VERSION } from "#lib/version.ts"

interface Props {
  title: string
  /** Server-rendered outcome of a redirect. Action results fill the same region from the client instead. */
  alert?: Alert | undefined
}

const { title, alert } = Astro.props
const { user, isAdmin, characters } = Astro.locals

// One constant so the navbar and the content below it cannot drift apart.
const container = "mx-auto w-full max-w-6xl px-4"
const path = Astro.url.pathname
const navLink = (href: string): string => `btn btn-ghost btn-sm${path === href ? " btn-active" : ""}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · guild-sim</title>
    <Font cssVariable="--font-ibm-plex-sans" preload />
    <Font cssVariable="--font-ibm-plex-mono" />
  </head>
  <body class="flex min-h-screen flex-col bg-base-200">
    <div class="navbar border-b border-base-content/10 bg-base-100">
      <div class:list={[container, "flex items-center gap-1"]}>
        <a href={user ? "/submit" : "/"} class="btn btn-ghost px-2 font-mono text-base font-semibold tracking-tight">
          guild-sim
        </a>
        <div class="flex-1"></div>
        {
          user && (
            <>
              {characters.length > 0 && (
                <a href="/submit" class={navLink("/submit")}>
                  Submit
                </a>
              )}
              {isAdmin && (
                <a href="/admin" class={navLink("/admin")}>
                  Admin
                </a>
              )}
              <span class="hidden px-2 text-sm text-base-content/60 sm:inline">{user.name}</span>
              <form method="POST" action="/sign-out">
                <button class="btn btn-ghost btn-sm" type="submit">
                  Sign out
                </button>
              </form>
            </>
          )
        }
      </div>
    </div>

    <main class:list={[container, "flex-1 py-8"]}>
      <div
        id="alert"
        class:list={[
          "alert alert-soft mb-6",
          {
            hidden: !alert,
            "alert-success": alert?.kind === "success",
            "alert-warning": alert?.kind === "warning",
            "alert-error": alert?.kind === "error",
          },
        ]}
      >
        <span>{alert?.message}</span>
      </div>
      <slot />
    </main>

    <footer class="border-t border-base-content/10 py-5">
      <div class:list={[container, "text-center font-mono text-xs text-base-content/40"]}>v{VERSION}</div>
    </footer>

    <script>
      import { bindActionForms } from "#lib/action-form.ts"

      bindActionForms()
    </script>
  </body>
</html>
