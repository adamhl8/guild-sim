---
interface Props {
  status: string
  label?: string | undefined
  error?: string | null | undefined
}

const { status, label, error } = Astro.props

const CLASSES: Record<string, string> = {
  queued: "badge-ghost",
  running: "badge-info",
  uploading: "badge-info",
  done: "badge-success",
  failed: "badge-error",
  skipped: "badge-warning",
}
---

<span class:list={["badge", CLASSES[status] ?? "badge-ghost"]} title={error ?? status}>
  {label ? `${label}: ${status}` : status}
</span>
