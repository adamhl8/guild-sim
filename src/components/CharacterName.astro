---
import { classColorClass } from "#lib/wow-class.ts"

interface Props {
  name: string
  realm: string
  wowClass: string
}

const { name, realm, wowClass } = Astro.props
---

<span class="font-mono whitespace-nowrap">
  <span class={classColorClass(wowClass)}>{name}</span><span class="text-base-content/40">-{realm}</span>
</span>
